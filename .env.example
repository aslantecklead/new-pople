# Telegram bot
TELEGRAM_BOT_TOKEN=replace-with-botfather-token
# Comma-separated numeric Telegram user IDs. Leave empty only for local testing.
ALLOWED_TELEGRAM_IDS=
# Usernames are accepted for the first launch; numeric IDs are more stable.
ALLOWED_TELEGRAM_USERNAMES=aslandevx
# Default official endpoint. For large videos point this to a local Bot API server.
TELEGRAM_API_ROOT=https://api.telegram.org

# Internal health API (the Telegram bot does not need a browser panel).
API_PORT=8080
POSTGRES_DB=video_factory
POSTGRES_USER=video_factory
POSTGRES_PASSWORD=change-me-before-deploying
REDIS_URL=redis://redis:6379
OLLAMA_MODEL=qwen3.5:4b
