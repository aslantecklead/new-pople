# The API is exposed by the server; the web app runs on the local computer.
API_PORT=8080
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=video_factory
POSTGRES_USER=video_factory
POSTGRES_PASSWORD=change-me-before-deploying
REDIS_URL=redis://redis:6379
# Необязательный ключ Pexels для поиска внешних стоков. Файлы из Pexels
# сначала скачиваются вами в библиотеку с учётом лицензии провайдера.
PEXELS_API_KEY=
COVERR_API_KEY=
# Wikimedia Commons работает без ключа и включён по умолчанию. Разрешённые
# типы лицензии: public domain, CC0 и CC BY без ShareAlike.
WIKIMEDIA_COMMONS_ENABLED=true
WIKIMEDIA_USER_AGENT=NewsVideoFactory/0.1 (self-hosted local test)
# Необязательно: локальная модель Ollama подготовит более точные поисковые сцены.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
